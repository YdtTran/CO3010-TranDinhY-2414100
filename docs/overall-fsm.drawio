        <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;strokeWidth=2;fillColor=#d5e8d4;strokeColor=#82b366;" id="green" value="EDIT GREEN&#xA;BTN2: increment draft (1–99, wrap)">
