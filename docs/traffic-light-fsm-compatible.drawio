      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="modes-title" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=16;fontColor=#243247;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;" parent="1" vertex="1" value="&lt;b&gt;PROJECT OPERATING MODES&lt;/b&gt;">
          <mxGeometry y="35" height="45" as="geometry" x="70" width="950" />
