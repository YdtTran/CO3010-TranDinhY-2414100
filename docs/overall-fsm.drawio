        <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" id="anote" value="Each 1 s: decrease both counters.&#xA;On timeout: FSM sets next colors and times.&#xA;RED = GREEN + YELLOW.">
          <mxGeometry y="930" width="340" as="geometry" height="100" x="160" />
        </mxCell>
        <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" id="mnote" value="BTN2: one phase per press; no held repeat.&#xA;BTN3: unused.&#xA;No countdown; display initial phase times.">
          <mxGeometry y="930" width="340" as="geometry" height="100" x="580" />
        </mxCell>
        <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" id="snote" value="All edit states: blink selected color every 250 ms.&#xA;BTN3 [invalid]: stay; keep saved config.&#xA;Validate 1–99 s and RED = GREEN + YELLOW.&#xA;Editing RED adjusts GREEN, preserves YELLOW.">
          <mxGeometry y="930" width="370" as="geometry" height="120" x="1000" />
        </mxCell>
        <mxCell vertex="1" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;" id="footer" value="OWNERSHIP: FSMs own sequencing, timers and coordination. traffic_light only manages individual objects (color / time / GPIO).&#xA;IMPLEMENTATION CONSTRAINT: only USER CODE blocks inside int main(void) may change in main.c; preserve CubeMX-generated code.&#xA;Proposal, not a diagram extracted from the current firmware. BTN1 transitions apply from every internal state.">
