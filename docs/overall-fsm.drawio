        </mxCell>
        <mxCell id="ry" source="red" value="BTN3 / save; load YELLOW" edge="1" parent="1" target="yellow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;endArrow=block;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yg" source="yellow" value="BTN3 / save; load GREEN" edge="1" parent="1" target="green" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;endArrow=block;labelBackgroundColor=#ffffff;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="gr" source="green" value="BTN3 / save; load RED" edge="1" parent="1" target="red" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;endArrow=block;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1380" y="852" />
              <mxPoint x="1380" y="472" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" id="anote" value="Phase timer: GREEN = green_s; YELLOW = yellow_s.&lt;br&gt;Timeout: next phase modulo 4.&lt;br&gt;Display: ceil(timer_ms / 1000), add yellow to red during opposite green, then subtract 1 if nonzero.">
          <mxGeometry y="930" width="340" as="geometry" height="100" x="160" />
        </mxCell>
        <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" id="mnote" value="BTN2: next phase modulo 4; clear press flag.&lt;br&gt;BTN3: unused. No countdown.&lt;br&gt;Display uses stored phase times: green, yellow, or green + yellow for red.">
          <mxGeometry y="930" width="340" as="geometry" height="100" x="580" />
        </mxCell>
        <mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=15;strokeWidth=2;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" id="snote" value="BTN2: draft = draft % 99 + 1; clear press flag.&lt;br&gt;BTN3: save unconditionally, then enter next edit.&lt;br&gt;RED save: green=max(draft-yellow,0). YELLOW/GREEN save: replace that duration.&lt;br&gt;Each entry loads saved draft; selected color toggles every 250 ms; other colors OFF.">
          <mxGeometry y="930" width="370" as="geometry" height="120" x="1000" />
        </mxCell>
        <mxCell vertex="1" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;" id="footer" value="BOOT: green=2 s; yellow=3 s. RUNTIME: TIM2 every 10 ms → SOFT_TIMER_Run + FSM_ScanButtons. Outputs: scan one digit every 20 ms; toggle indicator every 250 ms.&lt;br&gt;SETTING display: 02 / 03 / 04 on first pair, draft on second. AUTO/MANUAL: straight countdown then cross countdown.&lt;br&gt;Sources: src/main.c, fsm.c, fsm_automatic.c, fsm_manual.c, fsm_setting.c. BTN1 transitions apply from every state in the source mode.&lt;br&gt;Current limits: zero green and totals above 99 accepted; draft is uint8_t. A = straight; B = cross. AUTO/MANUAL colors identify modes; edit colors identify the selected lamp.">
          <mxGeometry y="1080" width="1230" as="geometry" height="90" x="140" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>